# ==== Base de données ====
# dev local : postgres://triage:triage@localhost:5433/triage (docker compose, port hôte 5433)
# docker/prod : postgres://triage:triage@postgres:5432/triage
DATABASE_URL=postgres://triage:triage@postgres:5432/triage

# ==== Application ====
APP_URL=https://brules.iqmed.io
SESSION_SECRET=change-me-32-chars-minimum

# ==== Agent IA (facultatif — vide = fonctions IA neutralisées, fail-open) ====
ANTHROPIC_API_KEY=

# ==== Email (SMTP) — dev : Mailpit (localhost:1025, UI :8025) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Triage brûlés <noreply@iqmed.io>"

# ==== Push web — générer : npx web-push generate-vapid-keys ====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@iqmed.io

# ==== OSRM (vide = estimation haversine, voir docs/DECISIONS.md D-004) ====
# dev local : http://localhost:5000 · docker/prod : http://osrm:5000
OSRM_URL=http://osrm:5000

# ==== Production uniquement ====
# RUN_MIGRATIONS_ON_BOOT=1  (déjà positionné dans docker-compose.yml)

# ==== Infrastructure — utilisé par Claude Code pour le DNS et le déploiement ====
DNS_PROVIDER=hostinger   # DNS de iqmed.io géré via le connecteur MCP Hostinger (pas de jeton ici)
VPS_IP=
VPS_SSH_USER=root
DOKPLOY_URL=           # ex. https://VPS_IP:3000 (vide si Dokploy pas encore installé)
DOKPLOY_API_TOKEN=
